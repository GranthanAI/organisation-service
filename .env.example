# organisation-service settings. `make setup` copies this to .env (git-ignored). Never commit .env or real secrets.
# Use 127.0.0.1, never localhost (Windows resolves localhost to IPv6 first).

# --- Service ---
# development | production. In production the service REFUSES to start with any development default below.
ENVIRONMENT=development
# Must be false in production.
DEBUG=true
# Port this service listens on (shared dev ports: auth 8001, conversation 8002, billing 8090, org 8010).
SERVICE_PORT=8010
# Postgres. 5433 is the host port mapped onto graphgpt-postgres in ../docker-compose.yml. Runtime role: DML only.
DATABASE_URL=postgresql+asyncpg://postgres:1234@127.0.0.1:5433/organisation_service_db
# Connection pool size per process.
DB_POOL_SIZE=5
# Extra connections allowed above DB_POOL_SIZE under load.
DB_MAX_OVERFLOW=5
# Seconds to wait when opening a database connection.
DB_CONNECT_TIMEOUT_SECONDS=5
# Server-side cap per SQL statement, in milliseconds.
DB_STATEMENT_TIMEOUT_MS=3000
# Redis (rate limits, caches).
REDIS_URL=redis://127.0.0.1:6379/0
# Kafka brokers (outbox publish, consumers).
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
# Consumer group for user-events and user.deleted.
KAFKA_CONSUMER_GROUP=organisation-service
# Timeout per dependency probe in /ready, in seconds.
READY_PROBE_TIMEOUT_SECONDS=2
# Proxies (IPs/CIDRs, comma-separated, or *) whose X-Forwarded-For is trusted for per-IP rate limits (the gateway).
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Identity ---
# HS256 secret. Must equal auth-service's JWT_SECRET_KEY (the shared dev value below is auth-service's dev secret).
# Production refuses this value: set a unique 32+ character secret, the same one auth-service signs with.
JWT_SECRET_KEY=supersecretjwtkeyforauthservicelocaldvelopment12345
# JWT signing algorithm.
JWT_ALGORITHM=HS256
# Expected `iss` claim, always verified. Must equal what auth-service signs with (https://auth.granthan.com).
JWT_ISSUER=https://auth.granthan.com
# Callers of /internal/*, as name:token,name:token (names unique). The "billing" token must equal billing-service's
# ORG_SERVICE_TOKEN. Production: 32+ character tokens, not these.
INTERNAL_SERVICE_TOKENS=billing:dev-billing-token,gateway:dev-gateway-token

# --- Billing ---
# billing-service dev instance.
BILLING_BASE_URL=http://127.0.0.1:8090
# Bearer token this service sends to billing. Production: unique, 32+ characters.
BILLING_SERVICE_TOKEN=dev-org-service-token

# --- Workers ---
# Start the outbox relay, consumer worker and job runner in this process. They never take the API down.
WORKERS_ENABLED=true
# Outbox rows published per batch.
OUTBOX_BATCH_SIZE=100
# Seconds between outbox polls when idle.
OUTBOX_POLL_SECONDS=1
# Seconds between job-runner polls when idle.
JOB_POLL_SECONDS=2
# Dead letters of the topics this service consumes.
KAFKA_DLQ_TOPIC=organisation.dlq
# Retries (after the first try) for a retryable consumer error before the message goes to the DLQ.
CONSUMER_MAX_RETRIES=3

# --- Email ---
# console (logs the message; development only) | smtp. Production refuses console.
EMAIL_SENDER=console
# From address on outgoing mail.
EMAIL_FROM=no-reply@granthan.local
# SMTP server, required when EMAIL_SENDER=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# SMTP password. Keep it only in your own .env.
SMTP_PASSWORD=
# Implicit TLS (port 465 style).
SMTP_USE_SSL=false
# STARTTLS upgrade (port 587 style).
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
# Public front-end URL; invite links are APP_BASE_URL/join/<token>. Production: https URL, not 127.0.0.1.
APP_BASE_URL=http://127.0.0.1:3000

# --- Invites ---
# Days an email invite stays valid.
INVITE_TTL_DAYS=14
# Longest life of a shareable invite link, in days.
LINK_MAX_TTL_DAYS=30
# Invites one organisation may create per day.
INVITES_PER_ORG_PER_DAY=200
# CSV upload limits.
CSV_MAX_ROWS=5000
CSV_MAX_BYTES=1048576

# --- Pilots and seats ---
# Member cap for a pilot organisation.
PILOT_MAX_MEMBERS=25
# Length of a pilot, in days.
PILOT_DAYS=30
# Where seat counts come from: staff | billing (billing is reserved for Phase 10).
SEAT_SOURCE=staff

# --- Domains ---
# Auto-join by verified email domain. Off until auth-service verifies emails (EMAIL_VERIFICATION_REQUIRED).
DOMAIN_AUTO_JOIN_ENABLED=false
